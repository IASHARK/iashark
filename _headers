  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://*.googletagmanager.com https://widgets.api-sports.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://media.api-sports.io https://widgets.api-sports.io https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://ksvjraqitxouwiabecai.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://ingesteer.services-prod.nsvcs.net; frame-src https://widgets.api-sports.io; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN

# CACHE (audit perf 15/09/2026). Aucun Cache-Control dans le bloc /* : Netlify
# fusionnerait ses valeurs avec celles des regles ci-dessous.
# - HTML : cache par defaut de Netlify (max-age=0, must-revalidate, ETag) ;
# - data-home.json et match/* (pages et JSON regeneres par le pipeline) :
#   max-age=120, stale-while-revalidate=600 ;
# - /assets/* : immutable. Chaque reference locale publiee porte ?v=<empreinte
#   du contenu> (scripts/build-public.js) ; un asset reference par un chemin
#   construit en JS doit changer de nom s'il change de contenu ;
# - JS/CSS hors /assets/ : regles immutables fichier par fichier, ajoutees a
#   dist/_headers par scripts/build-public.js (seulement les fichiers dont
#   toutes les references publiees portent l'empreinte) ;
# - dictionnaires i18n : 5 min, puis revalidation en arriere-plan.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Donnees JSON publiques : lues par les pages, jamais indexees comme documents
# (audit SEO 14/09/2026). Cache court (16/09/2026, quota Netlify depasse le
# 15/09) : 2 min, puis 10 min de revalidation en arriere-plan. Regeneres a
# chaque run du pipeline : jamais plus de quelques minutes de retard.
# data.json n'est plus publie (scripts/build-public.js).
/data-home.json
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=120, stale-while-revalidate=600
/buteurs-du-jour.json
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=120, stale-while-revalidate=600
/match/*
  Cache-Control: public, max-age=120, stale-while-revalidate=600
/actus.json
  X-Robots-Tag: noindex
/transferts.json
  X-Robots-Tag: noindex
/i18n/dict/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
